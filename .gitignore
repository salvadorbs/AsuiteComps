### FreePascal ###
*.lps
*.compiled
*.[oa]
*.ppu
*.rst
*.cgi
*.exe
*.log
*.bak*
fp.ini
fp.cfg
fp.dsk

### Lazarus ###
# Lazarus compiler-generated binaries (safe to delete)
*.dll
*.so
*.dylib
*.lrs
*.res
*.dbg
*.o
*.or
*.a

# Lazarus autogenerated files (duplicated info)
*.rsj
*.lrt

# Lazarus local files (user-specific info)

# Lazarus backups and unit output folders.
# These can be changed by user in Lazarus/project options.
backup/
*.bak
lib/

# Application bundle for Mac OS
*.app/

# End of https://www.toptal.com/developers/gitignore/api/lazarus,freepascal

# FPCUnit test runner binary (built by tests/run_tests.sh)
/tests/AsuiteCompsTests
/tests/AsuiteCompsTests.exe

# Sample binaries (built by lazarus/lazbuild)
/samples/THotkeyManager/THotkeyManager
/samples/TButtonedEdit/tbuttonededit

# ShortcutGrabber default button images are source, not generated:
# keep the embedded resource file despite the global *.lrs rule.
!visual/ShortcutGrabber.lrs
